TRIP_ENVIRONMENT=development
TRIP_DATABASE_URL=sqlite:///./data/trippilot.db
TRIP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TRIP_STORAGE_BACKEND=local
TRIP_STORAGE_ROOT=./data/knowledge
TRIP_QUEUE_BACKEND=database
TRIP_REDIS_URL=redis://localhost:6379/0
TRIP_LLM_BASE_URL=
TRIP_LLM_API_KEY=
TRIP_LLM_MODEL=
TRIP_EMBEDDING_BASE_URL=
TRIP_EMBEDDING_BACKEND=api
# local 模式使用以下 BGE 配置，不需要 Embedding API Key。
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=True
TRIP_EMBEDDING_BATCH_SIZE=4
TRIP_EMBEDDING_MAX_LENGTH=8192
TRIP_EMBEDDING_API_KEY=
TRIP_EMBEDDING_MODEL=
TRIP_EMBEDDING_DIMENSION=1024
TRIP_RERANKER_BASE_URL=
TRIP_RERANKER_API_KEY=
TRIP_RERANKER_MODEL=
TRIP_RERANKER_TOP_N=12
TRIP_VECTOR_BACKEND=bm25
TRIP_MILVUS_URI=http://localhost:19530
TRIP_MILVUS_TOKEN=
TRIP_AMAP_KEY=
TRIP_MINIO_ENDPOINT=localhost:9000
TRIP_MINIO_ACCESS_KEY=
TRIP_MINIO_SECRET_KEY=
TRIP_MINIO_BUCKET=trippilot
TRIP_MINIO_SECURE=false
